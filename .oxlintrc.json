{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "vitest",
    "oxc",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": [
    ".next/**",
    ".features-gen/**",
    "playwright-report/**",
    "test-results/**",
    ".claude/**",
    ".superpowers/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
