{
  "name": "julien-gaudet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bddgen && playwright test",
    "check:static": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-static.mts"
  },
  "dependencies": {
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  }
}
